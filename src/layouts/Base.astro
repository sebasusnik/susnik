---
// Served from this site, not Google Fonts: one less origin to connect to
// before the text can draw, and one less request that reports the visit.
// Upright only; the site's one italic line has always been a synthetic slant.
import '@fontsource-variable/jetbrains-mono';
import Analytics from '@vercel/analytics/astro';
import Meta from '../components/Meta.astro';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
  /** The page's language. The site is in English; a b-side may not be. */
  lang?: 'en' | 'es';
}
const {
  title = 'Sebastián Sušnik — Product Engineer',
  description =
    'Sebastián Sušnik (Susnik), product engineer in Buenos Aires, building PixFit at Winclap. A log of things I make: software, circuits, noise.',
  noindex = false,
  lang = 'en',
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <Meta title={title} description={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title="B-sides — Sebastián Sušnik" href="/b-sides/rss.xml" />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg font-mono text-[13px] leading-relaxed antialiased">
    <p
      class="hidden inverted:block fixed top-3.5 inset-x-0 z-10 text-center text-[11px] uppercase tracking-[.3em] text-mute"
    >
      the light hurts
    </p>
    <slot />
    <script>
      import '../scripts/presence.ts';
    </script>
    <!-- Page views, without cookies or anything that follows a visitor
         across sites. Only reports on Vercel; locally the script 404s. -->
    <Analytics />
  </body>
</html>
