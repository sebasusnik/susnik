---
import { readFileSync } from 'node:fs';

/**
 * One track, one button. The waveform comes from the JSON next to the MP3, so
 * it is drawn at build time and nothing is fetched until play is pressed.
 */
interface Props { src: string; title: string; class?: string }
const { src, title, class: className = 'mt-10' } = Astro.props;

const { duration, shape } = JSON.parse(
  readFileSync(`public/audio/${src}.json`, 'utf8'),
) as { duration: number; shape: number[] };

const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
---
<figure class:list={['player', className]} data-duration={duration}>
  <audio src={`/audio/${src}.mp3`} preload="none"></audio>

  <figcaption class="flex items-baseline gap-4 text-[11px] uppercase tracking-[.2em] text-mute">
    <button
      type="button"
      data-play
      aria-label={`Play ${title}`}
      class="w-[1.5ch] shrink-0 text-fg hover:text-fg"
    >▶</button>
    <span class="min-w-0 flex-1 truncate">{title}</span>
    <span class="shrink-0 tabular-nums"><span data-now>0:00</span> / {clock(duration)}</span>
  </figcaption>

  <div
    data-seek
    role="slider"
    tabindex="0"
    aria-label="Seek"
    aria-valuemin="0"
    aria-valuemax={Math.round(duration)}
    aria-valuenow="0"
    aria-valuetext={`0:00 of ${clock(duration)}`}
    class="mt-3 flex h-8 cursor-pointer items-end gap-px"
  >
    {shape.map((v) => (
      <span class="flex-1 bg-faint" style={`height:${Math.max(6, v * 100)}%`}></span>
    ))}
  </div>
</figure>

<script>
  import '../scripts/player.ts';
</script>
