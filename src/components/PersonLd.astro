---
/**
 * Who this site belongs to, in the terms a search engine reads: a Person, the
 * profiles that are the same person (sameAs), and the site itself. The name
 * is Sušnik; most people type it without the š or the accent, so every
 * spelling is listed.
 *
 * The site is in English, but people search in Spanish too
 * ("susnik ingeniero"), so the occupation carries both languages and the
 * words people actually type for it.
 */
const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL('/', site).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${url}#person`,
      name: 'Sebastián Sušnik',
      alternateName: ['Sebastián Susnik', 'Sebastian Susnik', 'Sebastian Sušnik', 'Susnik'],
      url,
      image: new URL('/og.png', site).href,
      jobTitle: 'Product Engineer',
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Product Engineer',
        alternateName: [
          'Ingeniero de producto',
          'Software Engineer',
          'Ingeniero de software',
          'Software Developer',
          'Desarrollador de software',
          'Full-stack Developer',
          'Desarrollador full-stack',
          'Programador',
        ],
        occupationLocation: { '@type': 'City', name: 'Buenos Aires' },
      },
      knowsLanguage: ['es', 'en'],
      worksFor: { '@type': 'Organization', name: 'Winclap' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Buenos Aires',
        addressCountry: 'AR',
      },
      knowsAbout: ['Product engineering', 'TypeScript', 'Go', 'AWS', 'Generative AI', 'Rust', 'ESP32'],
      sameAs: ['https://github.com/sebasusnik', 'https://www.linkedin.com/in/sebasusnik'],
    },
    {
      '@type': 'WebSite',
      '@id': `${url}#website`,
      url,
      name: 'Susnik',
      inLanguage: 'en',
      author: { '@id': `${url}#person` },
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
