---
import { day, type Note, noteHref } from '../lib/notes';

/**
 * The newest b-side, announced above the setlist like a date added to a flyer.
 * The list under the setlist is the rest of the tour; this is what is new.
 */
interface Props {
  note?: Note;
  project?: string;
}
const { note, project } = Astro.props;
---
{note && (
  <a
    href={noteHref(note)}
    data-latest
    class="-mx-3 mb-12 grid grid-cols-[auto_1fr] items-baseline gap-x-3 border-y border-line px-3 py-3
           text-[11px] uppercase tracking-[.2em] text-mute transition-colors hover:bg-lift
           focus-visible:outline-offset-[-2px] sm:grid-cols-[72px_1fr_auto] sm:gap-x-6"
  >
    <span class="text-blood">new<span class="sr-only"> b-side</span></span>
    <span class="normal-case tracking-normal text-[13px] text-fg">
      <span class="text-mute">{day(note.data.date)}</span>&nbsp;&nbsp;<span lang={note.data.lang}>{note.data.title}</span>
    </span>
    <span class="hidden whitespace-nowrap sm:inline">{project ? `${project} →` : '→'}</span>
  </a>
)}
