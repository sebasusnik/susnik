---
import { KINDS, type Project } from '../lib/entries';
import Row from './Row.astro';

interface Props {
  entries: Project[];
  /** B-sides per entry id. */
  counts?: Record<string, number>;
  /**
   * How many to play before the encore. Left out, the whole setlist shows: it
   * is only cut short to make room for the b-sides under it.
   */
  set?: number;
}
const { entries, counts = {}, set = entries.length } = Astro.props;

// The set proper; the rest wait for the encore.
const encore = entries.length - set;

// Only offer a filter for kinds that actually have something behind them.
const present = KINDS.filter((k) => entries.some((e) => e.data.kind === k));
---
<main class="mx-auto max-w-[760px] px-6 pb-[120px]">
  <slot name="top" />
  <div
    class="-mx-3 flex flex-col items-start justify-between gap-2.5 border-b border-line-strong px-3 pb-3
           text-[11px] uppercase tracking-[.2em] text-mute sm:flex-row sm:items-baseline sm:gap-4"
  >
    <h2>setlist</h2>
    <!-- biome-ignore lint/a11y/useSemanticElements: a fieldset is for a form; these buttons filter the list below -->
    <div class="flex flex-wrap gap-4" role="group" aria-label="Filter by kind">
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="uppercase text-mute hover:text-fg aria-pressed:text-fg"
      >all</button>
      {present.map((k) => (
        <button
          type="button"
          data-filter={k}
          aria-pressed="false"
          class="uppercase text-mute hover:text-fg aria-pressed:text-fg"
        >{k}</button>
      ))}
    </div>
  </div>

  {entries.map((entry, i) => <Row entry={entry} notes={counts[entry.id]} encore={i >= set} />)}
  {encore > 0 && (
    <button
      type="button"
      data-encore-button
      aria-expanded="false"
      class="-mx-3 flex w-[calc(100%+24px)] items-baseline justify-between gap-x-3
             px-3 py-[18px] text-[11px] uppercase tracking-[.2em] text-mute transition-colors
             hover:bg-lift hover:text-fg focus-visible:outline-offset-[-2px]"
    >
      <span>encore</span>
      <span data-more>{encore} more ↓</span>
      <span data-less hidden>{encore} less ↑</span>
    </button>
  )}
  <p class="py-10 text-mute" data-empty hidden>nothing of that kind. yet.</p>
  <slot />
</main>

<script>
  // Filtering is a class toggle, not a navigation: the setlist is one page and
  // every entry is already here.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  // An entry is its row and, for some, the player under it; they go together.
  const rows = document.querySelectorAll<HTMLElement>('[data-entry]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const encore = document.querySelector<HTMLButtonElement>('[data-encore-button]');
  const held = [...rows].filter((row) => row.dataset.encore !== undefined);
  // Played or not, the encore stays as it was left when a filter comes back to all.
  let played = false;

  const play = (on: boolean) => {
    played = on;
    for (const row of held) row.hidden = !on;
    if (!encore) return;
    encore.setAttribute('aria-expanded', String(on));
    encore.querySelector<HTMLElement>('[data-more]')!.hidden = on;
    encore.querySelector<HTMLElement>('[data-less]')!.hidden = !on;
    // Folding it back pulls the page up under the reader; keep the button in view.
    if (!on) encore.scrollIntoView({ block: 'nearest' });
  };

  encore?.addEventListener('click', () => play(!played));

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const kind = button.dataset.filter;
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));

      // A filter shows every entry of its kind; only the full set has an encore.
      const all = kind === 'all';
      let shown = 0;
      for (const row of rows) {
        const match = all || row.dataset.kind === kind;
        row.hidden = !match || (all && !played && row.dataset.encore !== undefined);
        if (match) shown++;
      }
      if (encore) encore.hidden = !all;
      if (empty) empty.hidden = shown > 0;
    });
  }
</script>
