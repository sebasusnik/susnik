{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!!**/public"] },

  // Reads an .astro file whole, template included, so a variable used only in
  // the markup is not reported as unused.
  "html": { "experimentalFullSupportEnabled": true },

  // One format for everything, checked in CI. A table worth aligning by hand
  // says so with `biome-ignore format`. .astro files are left out: Biome's
  // HTML formatter is experimental, and it moves whitespace inside inline
  // elements, which changes what renders.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },

  // @apply and friends; @tailwind is v3's and has to be named.
  "css": { "parser": { "tailwindDirectives": true } },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Scripts query elements the same file just rendered; a guard on each
      // one would be noise.
      "style": { "noNonNullAssertion": "off" },
      "suspicious": {
        "noUnknownAtRules": { "level": "error", "options": { "ignore": ["tailwind"] } }
      }
    }
  },

  "overrides": [
    {
      // The tests reach into the page through debug hooks on window.
      "includes": ["tests/**"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
